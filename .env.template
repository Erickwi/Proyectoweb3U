# ===========================================
# Configuración del Proyecto Web 3U
# Copia este archivo como .env y completa los valores
# ===========================================

# Servidor de base de datos (usar 'db' para Docker/Podman, 'localhost' para local)
DB_SERVER=

# Puerto de MySQL/MariaDB
DB_PORT=

# Nombre de la base de datos
DB_NAME=

# Usuario de la base de datos
DB_USER=

# Contraseña de la base de datos
DB_PASS=

# Contraseña root de MySQL/MariaDB (solo para Docker)
DB_ROOT_PASSWORD=
